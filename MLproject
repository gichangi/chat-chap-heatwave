name: heatwave_covariate_model

uv_env: pyproject.toml
supported_period_type: week
required_covariates:
  - rainfall
  - mean_temperature
allow_free_additional_continuous_covariates: true

meta_data:
  display_name: Heatwave covariate model
  description: Random forest disease forecast using climate variables and lagged heatwave indicators.
  author: eHealth Africa
  organization: eHealth Africa
  documentation_url: https://github.com/gichangi/chat-chap-heatwave
  author_assessed_status: orange

user_options:
  heat_lag_weeks:
    title: Heat lag weeks
    type: integer
    minimum: 1
    default: 4
    description: Number of weeks by which heatwave indicators are lagged.
  n_samples:
    title: Prediction samples
    type: integer
    minimum: 1
    default: 100
    description: Number of residual bootstrap samples returned per forecast row.
  random_seed:
    title: Random seed
    type: integer
    default: 42
    description: Seed used for model fitting and prediction sampling.
  n_estimators:
    title: Number of trees
    type: integer
    minimum: 1
    default: 200
    description: Number of trees in the random forest.

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: str
    command: "python chap_model/scripts/train_model.py --data {train_data} --model {model} --config {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: str
    command: "python chap_model/scripts/predict_model.py --historic {historic_data} --future {future_data} --model {model} --output {out_file} --config {model_config}"
