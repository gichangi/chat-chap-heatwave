name: ward_heatwave_threshold_model

uv_env: pyproject.toml
supported_period_type: week
required_covariates:
  - max_heat_index
target: heatwave_flag

meta_data:
  display_name: Ward heatwave threshold model
  description: Flags weeks where a ward's maximum Heat Index exceeds its own seasonal climatological threshold.
  author: eHealth Africa
  organization: eHealth Africa
  documentation_url: https://github.com/gichangi/chat-chap-heatwave
  author_assessed_status: orange

user_options:
  threshold_percentile:
    title: Climatological percentile
    type: number
    minimum: 0
    maximum: 100
    default: 90
    description: Ward-specific percentile used as the exceedance threshold.
  pooling_window_weeks:
    title: Seasonal pooling window
    type: integer
    minimum: 0
    maximum: 26
    default: 1
    description: Weeks on either side of each ISO week included in its climatology.
  min_baseline_observations:
    title: Minimum baseline observations
    type: integer
    minimum: 1
    default: 3
    description: Minimum pooled observations required to estimate a threshold.
  n_samples:
    title: Prediction samples
    type: integer
    minimum: 1
    default: 100
    description: Number of identical binary samples returned per forecast row.

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: str
    command: "python chap_model/scripts/train_model.py --data {train_data} --model {model} --config {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: str
    command: "python chap_model/scripts/predict_model.py --historic {historic_data} --future {future_data} --model {model} --output {out_file} --config {model_config}"
