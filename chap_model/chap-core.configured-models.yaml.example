# Copy this file to chap-core/config/configured_models/heatwave.yaml when your
# deployment requires explicit file-based seeding from the Git repository.
- url: https://github.com/gichangi/chat-chap-heatwave
  versions:
    v1: "@main"
  configurations:
    default:
      user_option_values:
        heat_lag_weeks: 4
        n_samples: 100
        random_seed: 42
        n_estimators: 200
      additional_continuous_covariates:
        - heatwave_days
        - mean_heat_index
        - max_heat_index
        - heatwave_event_count
